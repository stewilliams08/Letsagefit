# ── Secrets (set these in Railway, NOT in the repo) ──
#
# Each club is its own GoHighLevel subaccount, so credentials are keyed by the
# location slug (the URL path). Add one TOKEN + LOC pair per club:
#
#   letsagefit.com/bloomington  → GHL_TOKEN_BLOOMINGTON  + GHL_LOC_BLOOMINGTON
#   letsagefit.com/ellettsville → GHL_TOKEN_ELLETTSVILLE + GHL_LOC_ELLETTSVILLE
#
# (Uppercase the slug; replace any hyphen with an underscore.)

GHL_TOKEN_BLOOMINGTON=
GHL_LOC_BLOOMINGTON=

GHL_TOKEN_ELLETTSVILLE=
GHL_LOC_ELLETTSVILLE=

# Optional global fallback used by any club that has no per-location pair set.
GHL_TOKEN=
GHL_LOCATION_ID=

# Where the durable lead log is written (point at a Railway Volume in prod, e.g. /data/leads.json)
CLICK_LOG_PATH=/tmp/leads.json
# Optional: token required to view /leads (leave blank to disable the viewer)
LOG_VIEW_TOKEN=
# Port (Railway sets this automatically)
PORT=3000
